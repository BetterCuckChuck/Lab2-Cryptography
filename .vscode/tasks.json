            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "compiler: Microsoft cl.exe; library: build-msvc/aes_modes.lib"
        },
